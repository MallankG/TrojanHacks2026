# Copy to backend/.env (never commit .env).
SUPABASE_URL=https://jdkjunymxzxduvyckkmg.supabase.co
# Dashboard -> Project Settings -> API keys -> service_role / secret key. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still uses the legacy HS256 JWT secret (asymmetric signing keys use JWKS automatically).
SUPABASE_JWT_SECRET=

# Shared secret for the model-training and agent workers (X-Service-Key header). Generate a long random value.
SERVICE_API_KEY=

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_MB=25

# Apply migration 20261018000001 before enabling catalog contracts at CSV ingestion.
GOVERNANCE_CONTRACTS_ENABLED=false

# PRD 20.10: apply migration 20261018000002, provision attributes and case policies first.
ENTERPRISE_ENABLED=false
# Keep authorization enabled even if the enterprise UI/API feature is subsequently disabled.
CASE_AUTHORIZATION_ENABLED=false
DEPLOYMENT_REGION=US
APPROVED_DATA_DESTINATIONS=["local","supabase"]
# Trusted Ed25519 public key PEM path; private signing keys must remain outside the repo.
RELEASE_PUBLIC_KEY_PATH=

# Multi-agent workflows (apply 20261018000004_agent_orchestration.sql first).
# LLM_PROVIDER: groq (hosted, free tier; deploys) | ollama (local) | template (no LLM).
# Template fallback is explicitly labelled in receipts.
LLM_PROVIDER=ollama
# Groq: free key at https://console.groq.com/keys. With groq, add "groq" to APPROVED_DATA_DESTINATIONS.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
LLM_TIMEOUT_S=90
TRACELAYER_NODE_TIMEOUT_S=90
LLM_MAX_CALLS_PER_RUN=6
# Live requests reject TRACELAYER_USE_MOCKS=1 and TRACELAYER_PRECOMPUTED=1.

# Local 768-dimensional policy embeddings (ollama pull nomic-embed-text).
POLICY_EMBEDDING_MODEL=nomic-embed-text
