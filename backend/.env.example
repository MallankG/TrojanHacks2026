# Copy to backend/.env (never commit .env).
SUPABASE_URL=https://jdkjunymxzxduvyckkmg.supabase.co
# Dashboard -> Project Settings -> API keys -> service_role / secret key. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Only if the project still uses the legacy HS256 JWT secret (asymmetric signing keys use JWKS automatically).
SUPABASE_JWT_SECRET=

# Shared secret for the model-training and agent workers (X-Service-Key header). Generate a long random value.
SERVICE_API_KEY=

CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
MAX_UPLOAD_MB=25
