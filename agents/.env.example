# Copy to .env (gitignored). The backend process owns these; the agents package reads them.

# ollama | groq | template ("template" = deterministic output, no LLM, no network)
LLM_PROVIDER=ollama
# groq: free key at https://console.groq.com/keys; free-tier models with JSON-schema output:
# openai/gpt-oss-20b (default), openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_HOST=http://localhost:11434
# team model (empty = first model listed by `ollama list` / GET /api/tags)
OLLAMA_MODEL=qwen3.5:9b
# seconds for the whole Ollama phase of one LLM call (all attempts); then the template answers
LLM_TIMEOUT_S=90
# wall-clock limit for LLM nodes (draft_narrative, copilot_answer); must exceed LLM_TIMEOUT_S.
# Empty = LLM_TIMEOUT_S + 30.
TRACELAYER_LLM_NODE_TIMEOUT_S=
LLM_MAX_CALLS_PER_RUN=6
