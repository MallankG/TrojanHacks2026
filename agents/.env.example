# Copy to .env (gitignored). The backend process owns these; the agents package reads them.

# ollama | template ("template" = deterministic output, no LLM, no network)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
# set once the team picks a model (empty = first model listed by `ollama list` / GET /api/tags)
OLLAMA_MODEL=
# seconds for the whole Ollama phase of one LLM call (all attempts); then the template answers
LLM_TIMEOUT_S=120
# wall-clock limit for LLM nodes (draft_narrative, copilot_answer); must exceed LLM_TIMEOUT_S.
# Empty = LLM_TIMEOUT_S + 30.
TRACELAYER_LLM_NODE_TIMEOUT_S=
LLM_MAX_CALLS_PER_RUN=6
